# ── Local development ──────────────────────────────────────────────────────────
# Leave VITE_API_URL unset (or delete this file) in dev.
# The Vite proxy in vite.config.ts forwards /api/* → localhost:8000 automatically,
# which avoids CORS issues. Setting it to http://localhost:8000 here would bypass
# the proxy and cause CORS errors.

# ── Production ─────────────────────────────────────────────────────────────────
# Uncomment and set to your deployed FastAPI URL:
# VITE_API_URL=https://api.your-domain.com
